{
  "name": "@workspace/env",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint ."
  },
  "exports": {
    "./api": { "types": "./dist/api.d.ts", "default": "./dist/api.js" },
    "./web": { "types": "./dist/web.d.ts", "default": "./dist/web.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" }
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
