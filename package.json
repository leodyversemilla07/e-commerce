{
  "name": "e-commerce",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm run dev:all",
    "lint": "biome lint apps packages/eslint-config package.json turbo.json biome.json",
    "format": "biome format --write .",
    "check": "pnpm run lint && pnpm run typecheck",
    "typecheck": "turbo typecheck",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"pnpm run dev:web\" \"pnpm run dev:api\"",
    "dev:sqlite": "concurrently -n web,api -c cyan,magenta \"pnpm run dev:web\" \"pnpm --dir apps/api run dev:sqlite\"",
    "smoke:payments": "node scripts/e2e-payment-check.js",
    "validate:env": "node scripts/validate-env.mjs --service=all",
    "validate:env:api": "node scripts/validate-env.mjs --service=api",
    "validate:env:web": "node scripts/validate-env.mjs --service=web"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.2.1",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "lucide-react": "^1.8.0"
  }
}
